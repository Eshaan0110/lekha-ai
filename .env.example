# Lekha local development configuration.
#
# DO NOT copy this file by hand. Run `./dev.ps1 setup`, which creates `.env`
# with freshly generated random secrets. `.env` is git-ignored.
#
# Values here are placeholders only. The application refuses to start with a
# secret that still reads "CHANGE_ME".

LEKHA_ENVIRONMENT=local
LEKHA_LOG_LEVEL=INFO
LEKHA_LOG_FORMAT=console

# PostgreSQL 16 (host port deliberately non-default to avoid clashing with other projects)
LEKHA_POSTGRES_HOST=127.0.0.1
LEKHA_POSTGRES_PORT=15432
LEKHA_POSTGRES_DB=lekha
# Owner account: used by migrations only
LEKHA_POSTGRES_USER=lekha
LEKHA_POSTGRES_PASSWORD=CHANGE_ME
# Least-privilege account the API uses (created by ./dev.ps1 migrate)
LEKHA_DB_APP_USER=lekha_app
LEKHA_DB_APP_PASSWORD=CHANGE_ME

# Sign-in. "dev" trusts an X-Dev-User header and is refused outside local/test.
# The organisation ID is a fixed synthetic value (not a secret) used by ./dev.ps1 seed.
LEKHA_AUTH_MODE=dev
LEKHA_DEV_AUTH_ORGANISATION_ID=3119526c-3035-44df-8384-9d87db2929d8

# Redis (job queue from Phase 2)
LEKHA_REDIS_HOST=127.0.0.1
LEKHA_REDIS_PORT=16379
LEKHA_REDIS_PASSWORD=CHANGE_ME

# Qdrant vector database
LEKHA_QDRANT_URL=http://127.0.0.1:16333
LEKHA_QDRANT_API_KEY=CHANGE_ME

# S3-compatible local object storage (see docs/adr/0005)
LEKHA_S3_ENDPOINT_URL=http://127.0.0.1:18333
LEKHA_S3_ACCESS_KEY=CHANGE_ME
LEKHA_S3_SECRET_KEY=CHANGE_ME
LEKHA_S3_BUCKET=lekha-documents

# Uploads: 25 MiB limit. Confidential uploads stay blocked until the release gate passes.
LEKHA_UPLOAD_MAX_BYTES=26214400
