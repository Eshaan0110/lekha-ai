# Supply-chain guard (same idea as uv's exclude-newer): never install packages published
# after this date. Bump it deliberately when upgrading.
# Exception: vite 8.3.3 (2026-10-06) is pinned for a high-severity dev-server advisory
# (GHSA-698v-4r3x-3vcv and related) affecting 8.3.0-8.3.2 on Windows.
before=2026-10-01
save-exact=true
fund=false
audit=true
